# Copia este archivo a .env.local (ya está en .gitignore) y rellena el valor.
# La misma variable hay que configurarla también en Vercel: Project Settings →
# Environment Variables, en Production y Preview.
#
# Nunca la pongas con prefijo NEXT_PUBLIC_ — eso la expondría en el bundle
# del navegador. El servidor de /api/chat la lee sola del entorno.
ANTHROPIC_API_KEY=
